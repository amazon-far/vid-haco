# Copy to config.env and edit the paths for your machine:  cp config.env.example config.env
# Precedence: config.env < environment variables < `run.py --set KEY=VALUE`.

# haco_render: the contact-model / rendering env (see envs/haco_render_*.txt)
HACO_PY=/path/to/envs/haco_render/bin/python
HACO_ENV_LIB=/path/to/envs/haco_render/lib

# hawor: the tracker's own env (its DROID-SLAM extensions are compiled against it; see envs/hawor_*.txt)
HAWOR_PY=/path/to/envs/hawor/bin/python
HAWOR_ROOT=/path/to/HaWoR

# Caches. HF_CACHE is only needed by the ViT-H model (facebook/vjepa2-vith-fpc64-256).
HF_CACHE=${HOME}/.cache/huggingface
TORCH_HOME=${HOME}/.cache/torch

# Checkpoints (download with: python checkpoints/fetch_checkpoints.py)
CKPT_VITL=checkpoints/vitl.pt
CKPT_VITH=checkpoints/vith.pt

# Defaults
GPUS=0
MEM_FRAC=0.35
THR=0.52
MESH_ALPHA=0.6
# CLIP_LEN / STRIDE match how both checkpoints were trained; do not change them.
CLIP_LEN=8
STRIDE=2
